# Copy to .env and fill in. .env is gitignored — never commit it.

# Your Azure Speech resource name (must have a custom domain set)
SPEECH_RESOURCE=my-speech-resource

# The resource group it lives in
SPEECH_RESOURCE_GROUP=rg-voice

# Region of the resource
SPEECH_REGION=eastus

# Project id in Azure, and the ids derived from it. Any slug you like.
VOICE_PROJECT=my-voice

# Used in the consent statement. Both are normally you.
VOICE_TALENT_NAME=Your Name
VOICE_COMPANY_NAME=Your Name

# Mic index.
#   macOS: ffmpeg -f avfoundation -list_devices true -i ""
#   Linux: arecord -l
MIC=0

# Optional: reuse ids that already exist in Azure instead of deriving them
# from VOICE_PROJECT. Set these if you created a consent under another name.
# CONSENT_ID=my-voice-consent
# VOICE_ID=my-voice-personal
